            },
            "note": {
              "type": "string",
              "description": "Optional note for the store."
            }
          },
          "required": [
            "store_id",
            "full_name",
            "phone",
            "service_type",
            "appointment_date",
            "time_slot"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
